# ===== ANBU website environment =====
# Copy this file to ".env.local" and fill in values.

# Public site URL (dùng cho SEO: sitemap, canonical, Open Graph). Không có dấu "/" ở cuối.
NEXT_PUBLIC_SITE_URL=https://anbu.asia

# ----- SEO: xác minh quyền sở hữu domain -----
# Google Search Console → Settings → Ownership verification → HTML tag → chỉ lấy phần content="..."
NEXT_PUBLIC_GSC_VERIFICATION=
# Bing Webmaster Tools → import từ Search Console hoặc lấy meta tag msvalidate.01, chỉ lấy phần content="..."
NEXT_PUBLIC_BING_VERIFICATION=

# ----- Google Analytics 4 -----
# GA4 Measurement ID dạng G-XXXXXXXXXX, lấy trong Google Analytics → Admin → Data Streams
NEXT_PUBLIC_GA_ID=

# ----- Contact form email (tùy chọn) -----
# Nếu dùng Resend (https://resend.com) để gửi email lead, điền API key.
# Không điền cũng được: form vẫn hoạt động và lưu lead vào /data/submissions.json
RESEND_API_KEY=
# Email nhận thông báo lead mới
CONTACT_TO_EMAIL=dat.phan@anbu.asia
# Email hiển thị là người gửi (phải là domain đã verify trên Resend)
CONTACT_FROM_EMAIL=website@anbu.asia
