# Long-lived caching for static media. blog-media files are named with a unique timestamp and never edited in place.
/blog-media/*
  Cache-Control: public, max-age=31536000, immutable

/blog-covers/*
  Cache-Control: public, max-age=2592000

/projects/*
  Cache-Control: public, max-age=2592000

/services-chibi/*
  Cache-Control: public, max-age=2592000

/team/*
  Cache-Control: public, max-age=2592000

/logo/*
  Cache-Control: public, max-age=2592000

/work/*
  Cache-Control: public, max-age=2592000
